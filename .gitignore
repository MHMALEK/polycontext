.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# docker-compose bind volumes (sourcebot index, etc.)
.docker/

# generated artifacts — keep the dir, ignore everything in it except .gitkeep
outputs/*
!outputs/.gitkeep

# bake-off run outputs (regenerated by `make eval-run`)
eval/outputs/eval-*

# bridge dep installs happen inside the Docker container
bridge/*/node_modules/

# macOS / editor noise
.DS_Store
.idea/
.vscode/
