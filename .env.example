# --- Required ---
GEMINI_API_KEY=

# --- Repos & GitLab links ---
REPOS_ROOT=/Users/mohammadhosseinmalek/tract-projects/aider-experiments
REPOS=traceability,frontend,data-cloud-functions,data
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECTS=traceability=tract1/application/api/traceability,frontend=tract1/application/frontend,data-cloud-functions=tract1/application/data-cloud-functions,data=tract1/application/data

# --- Jira (only needed if you submit ticket_url/ticket_key, not raw text) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Sourcebot ---
# After running `docker compose up -d`, generate an API key in the Sourcebot UI
# (http://localhost:3000 → settings → API keys) and paste it here.
SOURCEBOT_URL=http://localhost:3000
SOURCEBOT_API_KEY=
SOURCEBOT_TIMEOUT_SECONDS=15

# Sourcebot infra secrets (generate with the commands below; do not commit).
#   openssl rand -base64 33   → SOURCEBOT_AUTH_SECRET
#   openssl rand -base64 24   → SOURCEBOT_ENCRYPTION_KEY
SOURCEBOT_AUTH_SECRET=
SOURCEBOT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=changeme

# --- Serena (MCP over SSE) ---
SERENA_URL=http://localhost:9121/sse
SERENA_TIMEOUT_SECONDS=20
SERENA_MAX_RESULTS_PER_QUERY=10

# --- Models ---
ENRICH_MODEL=gemini-2.5-flash
DECOMPOSE_MODEL=gemini-2.5-pro

# --- Retrieval limits ---
RETRIEVAL_MAX_HITS=40
RETRIEVAL_SNIPPET_LINES=8
DECOMPOSE_MAX_CONTEXT_CHARS=80000

# --- Output dir ---
OUTPUT_DIR=./outputs
