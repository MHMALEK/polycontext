# ============================================================================
# tech-decomposition configuration
# Copy this file to `.env` and fill in the values you need. Only the
# credentials for stages/providers you actually use are required.
# ============================================================================

# --- Provider credentials (set only those you use) ---
# Recommended default: Gemini for both stages (cheap Flash + capable Pro).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Generic OpenAI-compatible endpoint (LiteLLM proxy, vLLM, Ollama, etc.).
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Per-stage model selection ---
# Spec: "provider:model-name". Examples:
#   ENRICH_MODEL=gemini:gemini-2.5-flash
#   DECOMPOSE_MODEL=anthropic:claude-sonnet-4-5
#   DECOMPOSE_MODEL=openrouter:anthropic/claude-opus-4-5
ENRICH_MODEL=gemini:gemini-2.5-flash
DECOMPOSE_MODEL=gemini:gemini-2.5-pro

# --- Repos checked out locally (used by RipgrepRetriever + local agent) ---
# Point at the parent dir containing your project clones. The configured
# subdirectories in REPOS are each treated as one repo.
REPOS_ROOT=/path/to/your/repos
REPOS=traceability,frontend,data-cloud-functions,data
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECTS=traceability=tract1/application/api/traceability,frontend=tract1/application/frontend,data-cloud-functions=tract1/application/data-cloud-functions,data=tract1/application/data

# --- GitLab token (only for the gitlab-tract connector in Sourcebot's config.json) ---
# Generate at: https://gitlab.com/-/user_settings/personal_access_tokens
# Needs `read_api` + `read_repository` scopes. Leave empty if you rely on the
# local-mount connector instead (config.json: local-repos).
GITLAB_TOKEN=

# --- Jira (only needed for ``decompose --ticket-key`` or --post-to-jira) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Host ports (override if any collide with another local service) ---
# All published ports live here so changing one only requires editing
# .env. Container-internal ports stay constant; only the host publish
# changes. Defaults are offset from common dev ports (3000/5173/8000)
# by +10000 to avoid collisions with React/Vite/Django/etc.
API_PORT=18000
UI_PORT=15173
SOURCEBOT_HOST_PORT=13000
CLINE_SDK_BRIDGE_PORT=13040

# --- Sourcebot ---
# After `docker compose up -d`, generate an API key in the Sourcebot UI
# (http://localhost:${SOURCEBOT_HOST_PORT} → settings → API keys) and paste here.
# Keep SOURCEBOT_URL's port in sync with SOURCEBOT_HOST_PORT above.
SOURCEBOT_URL=http://localhost:13000
SOURCEBOT_API_KEY=
SOURCEBOT_TIMEOUT_SECONDS=30
# Skip MCP fallback; require /api/chat/blocking to succeed. Useful if you want
# fast-fail behavior in production rather than degraded fallback output.
# SOURCEBOT_DISABLE_MCP_FALLBACK=true

# Default for CLI ``ask`` engine when --engine is omitted: auto | sourcebot | local
ASK_VIA=auto

# --- Sourcebot infrastructure secrets ---
#   openssl rand -base64 33   → SOURCEBOT_AUTH_SECRET
#   openssl rand -base64 24   → SOURCEBOT_ENCRYPTION_KEY
SOURCEBOT_AUTH_SECRET=
SOURCEBOT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=changeme

# --- Serena (MCP over SSE; used by deep_decompose + local agent tools) ---
SERENA_URL=http://localhost:9121/sse
SERENA_TIMEOUT_SECONDS=20
SERENA_MAX_RESULTS_PER_QUERY=10

# --- Retrieval limits (cheap decompose mode) ---
RETRIEVAL_MAX_HITS=40
RETRIEVAL_SNIPPET_LINES=8
DECOMPOSE_MAX_CONTEXT_CHARS=80000

# --- Output dir (markdown answers, decompositions, metrics JSONL) ---
OUTPUT_DIR=./outputs
