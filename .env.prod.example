# ============================================================================
# tech-decomposition — PRODUCTION env template
# Copy to `.env.prod` and fill in real values. Used by `make prod`.
#
# Differences from .env.example:
# - Stronger Postgres password (NOT "changeme")
# - Sourcebot points at a deployed Sourcebot rather than localhost (if you
#   run one externally). If you're running the whole stack on this host,
#   leave SOURCEBOT_URL as http://sourcebot:3000 — the docker network host.
# - REPOS_ROOT not used in prod when GITLAB_TOKEN drives Sourcebot's own
#   cloning (path A in DEPLOYMENT.md). Leave commented.
# ============================================================================

# --- Provider credentials ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Per-stage model selection ---
ENRICH_MODEL=gemini:gemini-2.5-pro
DECOMPOSE_MODEL=gemini:gemini-2.5-pro

# --- Repos checked out locally (only if NOT using GitLab connector below) ---
# Comment out REPOS_ROOT in production if Sourcebot clones from GitLab itself.
# REPOS_ROOT=/srv/repos
REPOS=traceability,frontend,data-cloud-functions,data
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECTS=backend-api=your-company/backend-api,frontend-webapp=your-company/frontend-webapp

# --- GitLab token: Sourcebot uses this to clone the configured projects ---
# Strongly recommended in prod. Generate at
#   https://gitlab.com/-/user_settings/personal_access_tokens
# Scopes: read_api, read_repository.
GITLAB_TOKEN=

# --- Jira (only needed for decompose --post-to-jira) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Sourcebot ---
# In-stack: http://sourcebot:3000 (docker network host). External: full URL.
SOURCEBOT_URL=http://sourcebot:3000
SOURCEBOT_API_KEY=
SOURCEBOT_TIMEOUT_SECONDS=60
# Fail fast on misconfiguration; no MCP fallback in prod.
SOURCEBOT_DISABLE_MCP_FALLBACK=true

ASK_VIA=sourcebot

# --- Sourcebot infra secrets — GENERATE FRESH, do not reuse dev values ---
#   openssl rand -base64 33   → SOURCEBOT_AUTH_SECRET
#   openssl rand -base64 24   → SOURCEBOT_ENCRYPTION_KEY
SOURCEBOT_AUTH_SECRET=
SOURCEBOT_ENCRYPTION_KEY=

# --- Postgres password — use a real one, not 'changeme' ---
POSTGRES_PASSWORD=

# --- Retrieval limits ---
RETRIEVAL_MAX_HITS=40
RETRIEVAL_SNIPPET_LINES=8
DECOMPOSE_MAX_CONTEXT_CHARS=80000

OUTPUT_DIR=/app/outputs
