# jira-bridge environment — copy to `.env` and fill in.

# --- Jira Cloud auth (Basic auth: email + API token) ---
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- tech-decomposition API ---
# Where this service can reach the tech-decomposition FastAPI.
# Local dev: http://localhost:18000
# Compose:   http://app:8000
TECH_DECOMP_URL=http://localhost:18000

# Which adapter to call. Bake-off recommends `cursor` (0.773 ungrounded).
# See ../../eval/outputs/bakeoff-20260518T134739Z/comparison.md.
TECH_DECOMP_ADAPTER=cursor

# Repos to scope the decompose to. Optional — leave unset to use server default.
# Comma-separated, must match repo names known to tech-decomposition.
# TECH_DECOMP_REPOS=

# Per-request timeout when calling tech-decomposition. Decompose can be slow
# (60–120 s); make sure this is generous.
TECH_DECOMP_TIMEOUT_SECONDS=600

# --- HTTP server (only used by src/server.ts; CLI ignores this) ---
PORT=13200
HOST=0.0.0.0

# Optional shared secret. If set, /run endpoints require this in the
# `Authorization: Bearer <secret>` header. Webhook trigger uses the same.
JIRA_BRIDGE_SHARED_SECRET=
